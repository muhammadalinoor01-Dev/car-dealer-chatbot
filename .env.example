# Copy to .env and fill in your own values. NEVER commit the real .env.
# All variables are read via car_dealer_chatbot.config.Settings.

# --- Required ---
# Your OpenRouter API key: https://openrouter.ai/keys  (starts with sk-or-)
OPENROUTER_API_KEY=sk-or-your-key-here

# --- Optional (sensible defaults shown) ---
# OpenRouter model for the tool-calling agent. MUST support tool/function
# calling, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet,
# google/gemini-flash-1.5. Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenRouter API base URL (rarely needs changing).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sampling temperature (0.0 = deterministic, 2.0 = very creative).
TEMPERATURE=0.2

# Logging level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO


